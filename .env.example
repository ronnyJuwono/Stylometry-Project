# Optional local-only configuration. Copy to .env; never commit the filled file.
# Leave unset to keep PostgreSQL disabled. Use a least-privilege development role.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# Optional private filesystem root: absolute local directory outside this repo.
# Leave unset until private storage/access/retention controls are approved.
# The resolver never creates this directory or imports writing.
STYLOMETRY_PRIVATE_ROOT=
